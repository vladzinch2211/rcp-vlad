      expected_delivery: "{{ 'blocks.upcoming_orders.order_item.expected_delivery' | t }}",
      status: "{{ 'blocks.upcoming_orders.order_item.status' | t }}",
      button_edit: "{{ 'blocks.upcoming_orders.order_item.button_edit' | t }}",
      button_view: "{{ 'blocks.upcoming_orders.order_item.button_view' | t }}",
