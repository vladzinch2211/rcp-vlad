<div
  class="rcp-font-optimalMedium rcp-rounded-xl rcp-bg-white rcp-px-3 rcp-pb-6 rcp-pt-5 rcp-text-sm rcp-text-primary-base rcp-shadow-[0_4px_48px_rgba(0,0,0,0.08)] md:rcp-p-5"
>
  <div
    class="rcp-flex rcp-flex-col rcp-flex-nowrap rcp-items-stretch rcp-justify-start rcp-gap-4 md:rcp-flex-row md:rcp-items-center"
  >
    <div
      class="rcp-grid rcp-grid-cols-[94px_1fr] rcp-gap-x-4 md:rcp-grow lg:rcp-gap-x-8"
    >
      <div class="rcp-row-span-2 md:rcp-row-span-3">
        <div
          class="rcp-aspect-square rcp-overflow-hidden rcp-rounded-2xl [&_svg]:rcp-h-full [&_svg]:rcp-w-full [&_svg]:rcp-object-contain"
        >
          {{ 'product-apparel-1' | placeholder_svg_tag }}
        </div>
      </div>
      <div class="rcp-pt-2 lg:rcp-pt-0.5">
        <h3
          class="rcp-font-hanleyMonolineSans rcp-text-base rcp-uppercase rcp-text-inherit lg:rcp-text-lg"
        >
          Order #534201
        </h3>
      </div>
      <div
        class="rcp-flex rcp-flex-col rcp-flex-nowrap rcp-items-start rcp-justify-start rcp-gap-2 rcp-pt-1 rcp-text-base !rcp-leading-none md:rcp-order-1 lg:rcp-flex-row lg:rcp-items-center lg:rcp-gap-4 lg:rcp-pt-3 lg:rcp-pb-1 lg:rcp-text-lg"
      >
        <strong>Status:</strong>
        <span
          class="rcp-rounded-full rcp-bg-primary-gray rcp-px-3 rcp-py-2 lg:rcp-py-1.5"
        >
          Every 30 Days
        </span>
      </div>
      <div
        class="rcp-col-span-2 rcp-flex-row rcp-flex-wrap rcp-items-start rcp-justify-start rcp-gap-x-8 rcp-gap-y-1 rcp-space-y-3 rcp-pb-4 rcp-pt-8 md:rcp-col-span-1 lg:rcp-flex lg:rcp-space-y-0 lg:rcp-pb-0 lg:rcp-pt-4"
      >
        <dl
          class="rcp-flex rcp-flex-row rcp-flex-wrap rcp-items-start rcp-justify-start rcp-gap-1 lg:rcp-flex-nowrap"
        >
          <dt class="rcp-whitespace-nowrap rcp-font-bold">Total Products:</dt>
          <dd class="rcp-text-primary-base/70">12</dd>
        </dl>
        <dl
          class="rcp-flex rcp-flex-row rcp-flex-wrap rcp-items-start rcp-justify-start rcp-gap-1 lg:rcp-flex-nowrap"
        >
          <dt class="rcp-whitespace-nowrap rcp-font-bold">Subscription Date:</dt>
          <dd class="rcp-text-primary-base/70">4/30/2025</dd>
        </dl>
        <dl
          class="rcp-flex rcp-flex-row rcp-flex-wrap rcp-items-start rcp-justify-start rcp-gap-1 lg:rcp-flex-nowrap"
        >
          <dt class="rcp-whitespace-nowrap rcp-font-bold">Expected Delivery:</dt>
          <dd class="rcp-text-primary-base/70">4/30/2025</dd>
        </dl>
      </div>
    </div>
    <div
      class="rcp-flex rcp-flex-row rcp-flex-nowrap rcp-items-start rcp-justify-start rcp-gap-3"
    >
      {% render 'button-edit' %}
      <button
        class="cp-button cp-button--primary rcp-min-h-11 rcp-min-w-20 md:rcp-min-w-32"
      >
        View
      </button>
    </div>
  </div>
</div>
